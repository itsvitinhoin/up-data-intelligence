# Separate allowlist: Docker ignore rules alone do not protect Cloud Build upload.
**
!Dockerfile
!.dockerignore
!requirements.lock
!cloudbuild.yaml
!product.Dockerfile
!product-requirements.lock
!cloudbuild.product-api.yaml
!src/
!src/**/
!src/**/*.py
# Exact reviewed non-secret reporting definition; keep other JSON excluded.
!src/connectors/meta/approved_purchase_reporting.json
!sql/
!sql/**/
!sql/**/*.sql
!docs/
!docs/upzero-openapi.json
!config/
!config/analytics/
!config/analytics/mx-fashion.dev.json
