{
  "name": "up-data-intelligence-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src tests *.json *.mjs *.ts",
    "format:check": "prettier --check src tests *.json *.mjs *.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@svg-maps/brazil": "2.0.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "firebase": "12.19.0",
    "framer-motion": "13.4.6",
    "google-auth-library": "11.1.0",
    "lucide-react": "1.49.0",
    "next": "16.3.7",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "agent-browser": "0.38.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@grpc/grpc-js": "1.14.5"
